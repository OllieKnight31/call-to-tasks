# Copy this file to .env.local and fill it in. .env.local stays on your computer: it is ignored
# by git and is never uploaded by Vercel. The live app reads the same names from the Vercel
# project (Settings > Environment Variables), so every value you set here must be added there too.
# Lines marked AUTO are written for you by a command. Leave them empty.

# ---- Fathom ----
# Fathom > Settings > API Access > generate an API key.
FATHOM_API_KEY=
# AUTO: written by "npm run register" after your first deploy.
FATHOM_WEBHOOK_SECRET=

# ---- Notion ----
# The "Internal Integration Secret" of the connection you create at notion.so/profile/integrations.
NOTION_API_KEY=
# AUTO: written by "npm run setup:notion".
NOTION_TASKS_DB=
NOTION_CALLS_DB=
NOTION_LEDGER_DB=

# ---- Protection for the app's own addresses ----
# Two long random strings you make up yourself. Generate each with:  openssl rand -hex 24
# CRON_SECRET lets only Vercel's daily job call /api/sweep.
CRON_SECRET=
# ADMIN_KEY protects the manual sync address and the Notion webhook set-up step.
ADMIN_KEY=

# ---- Discord (optional: leave all of these empty to run without Discord) ----
# The bot token from discord.com/developers/applications > your app > Bot.
DISCORD_BOT_TOKEN=
# Right-click your server > Copy Server ID (turn on Developer Mode in Discord first).
DISCORD_GUILD_ID=
# Right-click the channel the task cards should go to > Copy Channel ID.
DISCORD_TASK_CHANNEL_ID=
# Optional: a channel for relay error messages.
DISCORD_LOG_CHANNEL_ID=

# ---- Optional: live status updates from Notion (README, "Optional: instant status updates") ----
# The verification token Notion sends when you create the webhook subscription.
NOTION_WEBHOOK_SECRET=
